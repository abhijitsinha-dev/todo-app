# Auto-detect text files and normalize line endings to LF on checkout/commit
* text=auto eol=lf

# Web source & configuration files
*.js           text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf
*.json         text eol=lf
*.html         text eol=lf
*.css          text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.svg          text eol=lf
.editorconfig  text eol=lf
.prettierrc    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Shell and scripts
*.sh           text eol=lf
*.bash         text eol=lf
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binary assets
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.webp         binary
*.ico          binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.eot          binary
*.mp3          binary
*.wav          binary
*.ogg          binary
*.pdf          binary

# Lockfiles
package-lock.json -diff
